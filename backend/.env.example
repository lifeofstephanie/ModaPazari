# ---- Core ----
PORT=5000
NODE_ENV=development
# MongoDB connection string (use a replica set / Atlas for transactions)
MONGO_URI=

# ---- Auth ----
JWT_SECRET=
JWT_EXPIRES=7d

# ---- Admin seed (npm run seed:admin) ----
ADMIN_EMAIL=admin@modapazari.com
ADMIN_PASSWORD=Admin@12345

# ---- CORS ----
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ---- Paystack ----
PAYSTACK_API=https://api.paystack.co
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ---- Fraud scoring (optional) ----
# If FRAUD_SERVICE_URL is unset, orders are treated as not flagged.
FRAUD_SERVICE_URL=
FRAUD_SCORE_THRESHOLD=0.8
