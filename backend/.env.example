# ---- Core ----
PORT=5000
NODE_ENV=development
# MongoDB connection string (use a replica set / Atlas for transactions)
MONGO_URI=

# ---- Auth ----
JWT_SECRET=
JWT_EXPIRES=7d

# ---- Admin seed (npm run seed:admin) ----
ADMIN_EMAIL=admin@modapazari.com
ADMIN_PASSWORD=Admin@12345

# ---- CORS ----
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ---- Paystack ----
PAYSTACK_API=https://api.paystack.co
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Percent the platform keeps from each vendor sale (rest is split to the vendor).
PLATFORM_COMMISSION_PERCENT=10

# ---- Pricing (VAT + shipping) ----
VAT_PERCENT=7.5
SHIPPING_FEE=1500
FREE_SHIPPING_THRESHOLD=50000

# Minutes a checkout holds reserved stock before the sweep releases it.
RESERVATION_MINUTES=30

# ---- Redis (optional) ----
# If set, rate limits are shared across instances via Redis; else in-memory.
REDIS_URL=

# ---- Fraud scoring (optional) ----
# If FRAUD_SERVICE_URL is unset, orders are treated as not flagged.
FRAUD_SERVICE_URL=
FRAUD_SCORE_THRESHOLD=0.8

# ---- Email (SMTP) ----
# If unset, transactional emails are skipped (logged, not sent).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Moda Pazari <no-reply@modapazari.com>
